{
  "name": "animal-tune-temp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "npx expo run:android",
    "device-android-clear": "rm -rf android && npx expo prebuild --clean && npx expo run:android --device",
    "device-android": "npx expo run:android --device",
    "ios": "npx expo prebuild --clean && npx expo run:ios",
    "web": "expo start --web",
    "build-android-preview-local": "eas build --platform android --profile preview --local --clear-cache",
    "build-ios-production-cloud-submit": "eas build --platform ios --profile production --auto-submit --clear-cache",
    "build-ios-production-cloud": " eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "dotenv": "^17.2.3",
    "expo": "~54.0.13",
    "expo-audio": "^1.0.13",
    "expo-av": "^16.0.7",
    "expo-font": "~14.0.9",
    "expo-localization": "^17.0.7",
    "expo-precise-metronome": "file:./modules/expo-precise-metronome",
    "expo-status-bar": "~3.0.8",
    "i18next": "^25.6.0",
    "react": "19.1.0",
    "react-i18next": "^16.2.3",
    "react-native": "0.81.4",
    "react-native-dotenv": "^3.4.11",
    "react-native-google-mobile-ads": "^16.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.14.0",
    "react-native-worklets": "0.5.1",
    "native-pitch-detector": "file:./modules/native-pitch-detector"
  },
  "devDependencies": {
    "@expo/cli": "^54.0.11",
    "@types/react": "~19.1.0",
    "@types/react-native-dotenv": "^0.2.2",
    "babel-preset-expo": "^54.0.4",
    "typescript": "~5.9.2"
  },
  "private": true
